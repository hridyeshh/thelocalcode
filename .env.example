# Contact form → email (https://resend.com). Without these the form says to WhatsApp/email instead.
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=you@example.com
# Needs a domain verified in Resend; until then Resend's test sender works for your own inbox.
CONTACT_FROM_EMAIL=thelocalcode <hello@thelocalcode.example>

# Your live address, for link previews (set once the domain is bought).
NEXT_PUBLIC_SITE_URL=https://thelocalcode.example

# WhatsApp click-to-chat, digits only with country code (e.g. 919876543210). Buttons hide when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
